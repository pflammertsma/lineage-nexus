rules_version = '2';

// Lineage Nexus — research sessions are private to the account that created them.
//
// Deploy with:  pnpm deploy:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A signed-in user may read and write only their own document tree. There is
    // no shared or public research data, so nothing is readable across accounts.
    match /users/{userId} {
      allow read, write, delete: if isOwner(userId);

      // The session document holds metadata only. Messages live in the
      // subcollection below, so this stays small and can be rewritten cheaply on
      // every change without re-sending the whole conversation.
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          // `messages` is deliberately absent: a document still carrying the old
          // inline array is rejected, which is what forces the migration to
          // remove it rather than leaving it orphaned in place.
          && request.resource.data.keys().hasOnly(['id', 'title', 'updatedAt', 'messageCount'])
          && request.resource.data.id is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.updatedAt is number
          && request.resource.data.messageCount is int
          && request.resource.data.messageCount >= 0;

        // One document per message. Shape-checked so a malformed write cannot be
        // planted in someone's history; Firestore's 1 MiB document limit is the
        // backstop on size above that.
        match /messages/{messageId} {
          allow read, delete: if isOwner(userId);

          allow create, update: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['seq', 'role', 'content', 'createdAt', 'steps', 'retry'])
            && request.resource.data.seq is int
            && request.resource.data.seq >= 0
            && request.resource.data.role is string
            && request.resource.data.role.size() <= 32
            && request.resource.data.content is string
            && request.resource.data.createdAt is number;
        }
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

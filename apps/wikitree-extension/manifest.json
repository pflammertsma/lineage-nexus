{
  "manifest_version": 3,
  "name": "Lineage Nexus - WikiTree Assistant",
  "version": "0.1.0",
  "description": "Automates populating biographies, sources, and vitals metadata from Lineage Nexus into WikiTree profile edit pages.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://*.wikitree.com/*",
    "https://lineage.nexus/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Lineage Nexus Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.wikitree.com/*",
        "https://lineage.nexus/*",
        "http://localhost/*"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "content_style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.svg",
        "assets/icon16.png",
        "assets/icon48.png",
        "assets/icon128.png"
      ],
      "matches": [
        "*://*.wikitree.com/*"
      ]
    }
  ]
}

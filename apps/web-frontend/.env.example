# Base URL of the Lineage Nexus cloud backend.
# Defaults to http://localhost:8081 when unset (see src/config.js).
VITE_API_BASE_URL=http://localhost:8081

# --- Firebase (optional) ----------------------------------------------------
# Enables Google sign-in and opt-in cross-device sync. Leave these blank and the
# app runs local-only: research is stored in the browser and the sync option is
# hidden rather than broken.
#
# These are client identifiers, not secrets — access is enforced by the rules in
# firestore.rules, which must be deployed for sync to work.
#
# Get them from: Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics measurement ID. Leave blank and no analytics load at all:
# the gtag script is never fetched. When set, it still only loads after the
# visitor accepts the consent banner, and Do Not Track is honoured as a "no".
VITE_GA_MEASUREMENT_ID=

# --- Error monitoring (optional) --------------------------------------------
# Sentry DSN. Leave blank and no monitoring loads at all. Reports are scrubbed
# of research content before sending (see src/monitoring.js).
VITE_SENTRY_DSN=

# --- Admin / archival service (optional) ------------------------------------
# Base URL of the archival API that serves /api/v1/admin/status.
# Admin requests authenticate with the signed-in user's Firebase ID token; there
# is no shared secret in the browser.
VITE_ADMIN_API_BASE_URL=

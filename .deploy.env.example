# Deployment target for scripts/deploy.mjs.
#
# Copy to `.deploy.env` (gitignored) and fill in. Every deploy command refuses to
# run unless LINEAGE_GCP_PROJECT matches the currently active gcloud project, so
# a forgotten `gcloud config set project` cannot deploy into the wrong place.
#
# These values may also be supplied as real environment variables, which win.

# The Google Cloud project that hosts Cloud Run, Firebase Auth and Firestore.
LINEAGE_GCP_PROJECT=

# Cloud Run region.
LINEAGE_REGION=europe-west4

# Origin(s) allowed to call the API, comma-separated. Required: the backend
# defaults to `*` when unset, which would leave it callable from anywhere.
LINEAGE_ALLOWED_ORIGINS=https://lineage.nexus

# Ceiling on Cloud Run instances.
#
# ⚠️ Keep this at 1 until the OpenArchieven limiter is moved to shared storage.
# All archive traffic egresses from Cloud Run, so OpenArchieven sees one IP for
# every user. The 2 req/s pacing is a process-wide clock: with a single instance
# it is globally correct no matter how many people are researching, but each
# extra instance adds another independent clock, so N instances hit the archive
# at N x the agreed rate from a single address. That is how you get banned.
#
# Raising this trades a real ban risk for concurrency. Fix the limiter first.
LINEAGE_MAX_INSTANCES=1

# --- Self-hosted archival gateway (optional) --------------------------------
# Only needed for `pnpm deploy:archival`. Without these, `deploy:all` skips the
# archival step with a warning instead of failing.
LINEAGE_OCI_HOST=
LINEAGE_OCI_USER=ubuntu
LINEAGE_OCI_KEY=.ssh/id_oci

# Credentials for the gateway container. Generate long random values; these are
# passed to the host in a temporary file, never on a command line.
LINEAGE_MEILI_MASTER_KEY=
LINEAGE_ADMIN_TOKEN=
